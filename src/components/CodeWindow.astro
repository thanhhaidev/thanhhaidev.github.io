---
import { Code } from 'astro:components';
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';

const packages = await getCollection('packages');

const code = `final hai = Engineer(
  name: '${profile.name}',
  role: '${profile.role}',
  company: '${profile.company}',
  location: '${profile.location}',
  stack: ['Flutter', 'Dart', 'Swift', 'Kotlin'],
  packages: ${packages.length}, // on pub.dev
  since: ${profile.codingSince},
);

void main() => runApp(hai);`;
---

<div class="card spot shadow-2xl shadow-black/40 light:shadow-black/5">
  <div class="flex items-center gap-2 border-b border-line bg-surface-2/60 px-4 py-3">
    <span class="size-3 rounded-full bg-[#ff5f57]"></span>
    <span class="size-3 rounded-full bg-[#febc2e]"></span>
    <span class="size-3 rounded-full bg-[#28c840]"></span>
    <span class="ml-3 rounded-md border border-line bg-surface px-2.5 py-0.5 font-mono text-xs text-ink-2">profile.dart</span>
    <span class="ml-auto font-mono text-[11px] text-ink-3">Dart · UTF-8</span>
  </div>
  <Code
    id="hero-code"
    code={code}
    lang="dart"
    themes={{ dark: 'github-dark-default', light: 'github-light-default' }}
    defaultColor="dark"
    class="overflow-x-auto px-4 py-5 font-mono text-[13px] leading-6 sm:text-sm"
  />
</div>

<script>
  // Types the snippet out once, keeping Shiki's highlighting by filling text nodes in place.
  const pre = document.getElementById('hero-code');
  const code = pre?.querySelector('code');

  if (code && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    pre!.style.minHeight = `${pre!.offsetHeight}px`;

    const walker = document.createTreeWalker(code, NodeFilter.SHOW_TEXT);
    const nodes: { node: Text; text: string }[] = [];
    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      if (!node.parentElement?.closest('.line')) continue;
      nodes.push({ node, text: node.data });
      node.data = '';
    }

    const cursor = document.createElement('span');
    cursor.className = 'animate-blink text-accent';
    cursor.textContent = '▋';
    code.classList.add('typing');

    const lines = [...code.querySelectorAll('.line')];
    let i = 0;
    let pos = 0;
    const tick = () => {
      const current = nodes[i];
      if (!current) {
        code.classList.remove('typing');
        return;
      }
      // Reveal every line up to the one being typed, including blank ones.
      const line = current.node.parentElement!.closest('.line')!;
      for (const l of lines.slice(0, lines.indexOf(line) + 1)) l.classList.add('shown');
      // Leading indentation appears at once; everything else one character at a time.
      const step = current.text.slice(pos).match(/^\s+/)?.[0].length || 1;
      pos += step;
      current.node.data = current.text.slice(0, pos);
      current.node.parentElement!.after(cursor);
      if (pos >= current.text.length) {
        i++;
        pos = 0;
      }
      setTimeout(tick, step > 1 ? 0 : 22);
    };

    // Start once the window is on screen (it sits below the fold on phones).
    const io = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      io.disconnect();
      setTimeout(tick, 400);
    });
    io.observe(pre!);
  }
</script>
