---
import type { ContributionDay } from '../lib/remote';
import { formatNumber } from '../lib/remote';
import { profile } from '../data/profile';

interface Props {
  total: number;
  days: ContributionDay[];
}

const { total, days } = Astro.props;

// GitHub's calendar has one column per week, Sunday on top. Pad the first week so
// each day lands on its weekday row.
const lead = new Date(`${days[0].date}T00:00:00Z`).getUTCDay();
const cells: (ContributionDay | null)[] = [...Array(lead).fill(null), ...days];
const weeks = Math.ceil(cells.length / 7);

const months = Array.from({ length: weeks }, (_, w) => {
  const first = cells.slice(w * 7, w * 7 + 7).find(Boolean);
  if (!first) return '';
  const date = new Date(`${first.date}T00:00:00Z`);
  // Label the first week whose days start a new month.
  return date.getUTCDate() <= 7 && w > 0 ? date.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' }) : '';
});

const levels = ['bg-ink/[0.07]', 'bg-accent/30', 'bg-accent/55', 'bg-accent/80', 'bg-accent'];
const label = (d: ContributionDay) =>
  `${d.count || 'No'} contribution${d.count === 1 ? '' : 's'} on ${new Date(`${d.date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}`;
---

<div class="card spot reveal p-5 md:p-6 lg:col-span-4">
  <div class="mb-5 flex flex-wrap items-baseline justify-between gap-2">
    <p class="text-sm text-ink-2">
      <span class="font-semibold text-ink">{formatNumber(total)}</span> contributions in the last year
    </p>
    <a
      href={profile.links.github}
      target="_blank"
      rel="noopener"
      class="font-mono text-xs text-ink-3 no-underline hover:text-accent">@{profile.handle} on GitHub ↗</a
    >
  </div>

  <!-- Cells stretch to fill the card, but never shrink below 10px; narrow screens scroll instead. -->
  <div class="contrib-scroll overflow-x-auto pb-1">
    <div style={{ minWidth: `${weeks * 13}px` }}>
      <div
        class="mb-1.5 grid gap-[3px] font-mono text-[10px] text-ink-3"
        style={{ gridTemplateColumns: `repeat(${weeks}, minmax(0, 1fr))` }}
        aria-hidden="true"
      >
        {months.map((m) => <span class="overflow-visible whitespace-nowrap">{m}</span>)}
      </div>
      <div
        class="grid grid-flow-col grid-rows-7 gap-[3px]"
        style={{ gridTemplateColumns: `repeat(${weeks}, minmax(0, 1fr))` }}
        role="img"
        aria-label={`${total} contributions in the last year`}
      >
        {
          cells.map((d) =>
            d ? (
              <span class:list={['aspect-square rounded-[3px]', levels[d.level] ?? levels[0]]} title={label(d)} />
            ) : (
              <span class="aspect-square" />
            ),
          )
        }
      </div>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-end gap-1.5 font-mono text-[11px] text-ink-3" aria-hidden="true">
    Less
    {levels.map((l) => <span class:list={['size-[11px] rounded-[3px]', l]} />)}
    More
  </div>
</div>

<script>
  // On narrow screens, start at the most recent weeks.
  document.querySelectorAll('.contrib-scroll').forEach((el) => (el.scrollLeft = el.scrollWidth));
</script>
