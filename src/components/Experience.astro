---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';

const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

// A stable, decorative short "commit hash" per job.
const hash = (s: string) => {
  let h = 0x811c9dc5;
  for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 0x01000193);
  return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7);
};
---

<section id="experience" class="pb-20 md:pb-28">
  <div class="wrap">
    <SectionHead index="02" eyebrow="experience" title="git log --career" />

    <ol class="relative before:absolute before:top-2 before:bottom-2 before:left-[7px] before:w-px before:bg-line">
      {
        jobs.map(({ id, data: job }) => (
          <li class="reveal relative grid grid-cols-[15px_1fr] gap-x-5 pb-10 last:pb-0 md:gap-x-8">
            <span
              class:list={[
                'relative mt-1.5 size-[15px] rounded-full border-2',
                job.current
                  ? 'border-accent bg-accent/30 shadow-[0_0_14px_var(--c-accent)]'
                  : 'border-line-2 bg-bg',
              ]}
              aria-hidden="true"
            />
            <div class="card spot p-5 md:p-6">
              <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs">
                <span class="text-accent-2">commit {hash(id)}</span>
                {job.current && (
                  <span class="rounded-md border border-accent/30 bg-accent/10 px-1.5 py-px text-accent">
                    HEAD → main
                  </span>
                )}
                <span class="text-ink-3 sm:ml-auto">{job.period}</span>
              </div>
              <h3 class="text-lg font-semibold tracking-[-0.01em]">
                {job.role} <span class="text-ink-3">@</span> {job.company}
              </h3>
              {job.highlights.length > 0 && (
                <ul class="mt-3 space-y-2 text-[15px] leading-relaxed text-ink-2">
                  {job.highlights.map((h) => (
                    <li class="relative pl-5 before:absolute before:left-0 before:font-mono before:text-ink-3 before:content-['+']">
                      {h.link && (
                        <>
                          <a
                            href={h.link.url}
                            target="_blank"
                            rel="noopener"
                            class="font-medium text-ink underline decoration-line-2 underline-offset-4 hover:decoration-accent"
                          >
                            {h.link.label}
                          </a>{' '}
                          —{' '}
                        </>
                      )}
                      {h.text}
                    </li>
                  ))}
                </ul>
              )}
              {job.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {job.tags.map((tag) => (
                    <span class="chip">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
