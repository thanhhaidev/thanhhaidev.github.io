---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const items = [
  { href: '#work', label: 'work' },
  { href: '#experience', label: 'experience' },
  { href: '#stack', label: 'stack' },
  { href: '#contact', label: 'contact' },
  { href: '/cv', label: 'cv' },
];
---

<header
  id="nav"
  class="sticky top-0 z-40 border-b border-transparent transition-colors data-scrolled:border-line data-scrolled:bg-bg/95"
>
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="#top" class="font-mono text-sm font-medium no-underline">
      <span class="text-accent">~/</span>{profile.handle}<span class="animate-blink text-accent">_</span>
    </a>
    <nav class="flex items-center gap-1" aria-label="Primary">
      {
        items.map((item, i) => (
          <a
            href={item.href}
            class="hidden rounded-md px-3 py-1.5 font-mono text-[13px] text-ink-2 no-underline transition-colors hover:bg-surface-2 hover:text-ink md:inline-block"
          >
            <span class="text-accent">0{i + 1}.</span>
            {item.label}
          </a>
        ))
      }
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
        class="ml-2 grid size-9 place-items-center rounded-lg border border-line bg-surface text-ink-2 transition-colors hover:border-line-2 hover:text-ink"
      >
        <Icon name="github" />
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle light mode"
        class="grid size-9 cursor-pointer place-items-center rounded-lg border border-line bg-surface text-ink-2 transition-colors hover:border-line-2 hover:text-ink"
      >
        <Icon name="sun" class="size-4 light:hidden" />
        <Icon name="moon" class="hidden size-4 light:block" />
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    if (next === 'light') root.dataset.theme = 'light';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
