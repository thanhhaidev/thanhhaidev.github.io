---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { index, eyebrow, title, description } = Astro.props;
---

<div class="reveal mb-10 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="mb-3 font-mono text-[13px] text-accent">// {index}. {eyebrow}</p>
    <h2 class="text-3xl font-semibold tracking-[-0.03em] md:text-4xl">{title}</h2>
    {description && <p class="mt-3 max-w-xl text-ink-2">{description}</p>}
  </div>
  <slot />
</div>
