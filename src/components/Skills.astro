---
import SectionHead from './SectionHead.astro';
import { skills } from '../data/profile';

const slug = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
---

<section id="stack" class="pb-20 md:pb-28">
  <div class="wrap">
    <SectionHead index="03" eyebrow="stack" title="Tools of the trade" />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((group) => (
          <div class="card spot reveal p-5">
            <div class="mb-4 flex items-baseline justify-between gap-3">
              <h3 class="font-mono text-sm font-medium">
                <span class="text-accent">~/</span>
                {slug(group.title)}
              </h3>
              <span class="font-mono text-[11px] text-ink-3">{group.note}</span>
            </div>
            <div class="flex flex-wrap gap-1.5">
              {group.primary?.map((item) => (
                <span class="chip border-accent/30 bg-accent/10 text-accent">{item}</span>
              ))}
              {group.items.map((item) => (
                <span class="chip">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
