---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = `https://avatars.githubusercontent.com/u/20614629?v=4&s=400`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.fullName,
  jobTitle: profile.role,
  worksFor: { '@type': 'Organization', name: profile.company },
  address: { '@type': 'PostalAddress', addressLocality: profile.location, addressCountry: 'VN' },
  alumniOf: 'Van Lang University',
  url: Astro.site?.href,
  image: ogImage,
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content={`@${profile.handle}`} />
    <meta name="theme-color" content="#09090b" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Runs before paint: restore the saved theme and opt in to JS-only effects. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-3 focus:py-2"
      >Skip to content</a
    >

    <!-- Backdrop: dotted grid fading out, plus two soft glows. -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[900px] overflow-hidden">
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,var(--c-grid)_1px,transparent_1px),linear-gradient(to_bottom,var(--c-grid)_1px,transparent_1px)] mask-[radial-gradient(ellipse_70%_60%_at_50%_0%,#000_40%,transparent_100%)] bg-size-[56px_56px]"
      >
      </div>
      <div class="absolute -top-40 left-1/2 h-[480px] w-[720px] -translate-x-[70%] rounded-full bg-accent/20 blur-[120px] light:bg-accent/10">
      </div>
      <div class="absolute -top-24 left-1/2 h-[380px] w-[560px] translate-x-[5%] rounded-full bg-accent-2/15 blur-[120px] light:bg-accent-2/10">
      </div>
    </div>

    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      document.querySelectorAll<HTMLElement>('.spot').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });
    </script>
  </body>
</html>
