---
import '../styles/global.css';
import '@fontsource-variable/inter';
import { getCollection, getEntries } from 'astro:content';
import Icon from '../components/Icon.astro';
import InlineCode from '../components/InlineCode.astro';
import { formatNumber, getPubStats } from '../lib/remote';
import { education, profile, skills } from '../data/profile';

const jobs = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const packages = (await getCollection('packages')).sort((a, b) => a.data.order - b.data.order);
const stats = new Map(await Promise.all(packages.map(async (p) => [p.id, await getPubStats(p.id)] as const)));

const featured = (await getCollection('projects', (p) => p.data.featured))[0];
const featuredIds = new Set(featured?.data.packages.map((ref) => ref.id) ?? []);
const featuredPackages = featured ? await getEntries(featured.data.packages) : [];
const otherPackages = packages.filter((p) => !featuredIds.has(p.id));

const strip = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const contacts = [
  { icon: 'pin', label: profile.location },
  { icon: 'mail', label: profile.email, href: `mailto:${profile.email}` },
  { icon: 'github', label: strip(profile.links.github), href: profile.links.github },
  { icon: 'linkedin', label: strip(profile.links.linkedin), href: profile.links.linkedin },
  { icon: 'arrow', label: strip(profile.website), href: profile.website },
] as const;

const meta = (id: string) => {
  const s = stats.get(id);
  return s ? `v${s.version} · ${s.points}/160 pub points · ${formatNumber(s.downloads)} downloads/month` : '';
};

const title = `${profile.name} — CV`;
const description = `CV of ${profile.name}, ${profile.role} at ${profile.company}.`;

// Shared class lists keep the sections visually consistent.
const h2 = 'mb-3 border-b-2 border-zinc-900 pb-1 text-[13px] font-bold tracking-[0.1em] text-zinc-900 uppercase';
const rowHead = 'flex flex-wrap items-baseline justify-between gap-x-4';
const date = 'text-[12.5px] font-semibold whitespace-nowrap text-zinc-700 tabular-nums print:text-[10.5px]';
const bullets = 'mt-1.5 list-disc space-y-1 pl-5 text-zinc-700 marker:text-zinc-500';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL('/cv', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <style>
      @page {
        size: A4;
        margin: 12mm 14mm;
      }
      @media print {
        html,
        body {
          background: #fff !important;
        }
        a {
          text-decoration: none !important;
        }
      }
    </style>
  </head>
  <!-- Ligatures are off: their glyphs extract as garbage in PDF text layers, which breaks ATS parsing. -->
  <body class="bg-zinc-100 font-['Inter_Variable',ui-sans-serif,sans-serif] text-zinc-800 [font-variant-ligatures:none] print:bg-white">
    <!-- Toolbar (screen only) -->
    <div class="sticky top-0 z-10 border-b border-zinc-200 bg-zinc-100/95 print:hidden">
      <div class="mx-auto flex h-14 max-w-[210mm] items-center justify-between gap-3 px-4">
        <a href="/" class="font-mono text-[13px] text-zinc-600 no-underline hover:text-sky-700">
          ← <span class="text-sky-700">~/</span>{profile.handle}
        </a>
        <button
          id="print"
          type="button"
          class="inline-flex cursor-pointer items-center gap-2 rounded-lg bg-zinc-900 px-3.5 py-2 text-[13px] font-medium text-white hover:bg-zinc-700"
        >
          <Icon name="download" class="size-4" /> Download PDF
        </button>
      </div>
    </div>

    <main
      class="mx-auto my-6 max-w-[210mm] bg-white px-6 py-8 text-[13.5px] leading-[1.55] shadow-xl shadow-zinc-300/60 sm:my-10 sm:min-h-[297mm] sm:px-[15mm] sm:py-[14mm] print:m-0 print:max-w-none print:p-0 print:text-[11.5px] print:shadow-none"
    >
      <!-- Header -->
      <header class="mb-6">
        <h1 class="font-sans text-[34px] leading-none font-bold tracking-[-0.03em] text-zinc-950 print:text-[30px]">
          {profile.name}
        </h1>
        <p class="mt-2 text-[16px] font-semibold text-sky-700 print:text-[14px]">
          {profile.role} — Native SDKs & Cross-platform
        </p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-[12.5px] text-zinc-700 print:text-[10.5px]">
          {
            contacts.map((c) => (
              <li class="inline-flex items-center gap-1.5">
                <Icon name={c.icon} class="size-3.5 text-sky-700" />
                {'href' in c ? (
                  <a href={c.href} class="text-zinc-800 no-underline hover:text-sky-700">
                    {c.label}
                  </a>
                ) : (
                  c.label
                )}
              </li>
            ))
          }
        </ul>
      </header>

      <!-- Summary -->
      <section class="mb-6">
        <h2 class={h2}>Summary</h2>
        <p class="text-zinc-700">
          Mobile engineer building <b class="font-semibold text-zinc-900">native SDKs for iOS and Android</b> and the
          cross-platform layers that expose them to app developers. Maintainer of{' '}
          <b class="font-semibold text-zinc-900">{packages.length} open-source Flutter & Dart packages</b> on pub.dev,
          including a Prebid Mobile header-bidding plugin with Google Ad Manager, AdMob and AppLovin MAX integrations.
          Professional software engineer since 2019, with full-stack web and mobile experience across Angular, React and
          Node.js.
        </p>
      </section>

      <!-- Experience -->
      <section class="mb-6">
        <h2 class={h2}>Experience</h2>
        <ol class="space-y-4">
          {
            jobs.map(({ data: job }) => (
              <li class="break-inside-avoid">
                <div class={rowHead}>
                  <h3 class="text-[15px] font-bold text-zinc-950 print:text-[13px]">{job.company}</h3>
                  <span class={date}>{job.period}</span>
                </div>
                <p class="font-semibold text-sky-700">{job.role}</p>
                {job.highlights.length > 0 && (
                  <ul class={bullets}>
                    {job.highlights.map((h) => (
                      <li>
                        {h.link && (
                          <>
                            <a href={h.link.url} class="font-semibold text-zinc-900 no-underline hover:text-sky-700">
                              {h.link.label}
                            </a>{' '}
                            —{' '}
                          </>
                        )}
                        {h.text}
                      </li>
                    ))}
                  </ul>
                )}
                {job.tags.length > 0 && (
                  <p class="mt-1.5 text-[12.5px] text-zinc-600 print:text-[10.5px]">
                    <b class="font-semibold text-zinc-800">Tech:</b> {job.tags.join(', ')}
                  </p>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Open source: kept on one page so the heading never ends up alone at a page bottom. -->
      <section class="mb-6 break-inside-avoid">
        <h2 class={h2}>Open source</h2>
        <ul class="space-y-3.5">
          {
            featured && (
              <li class="break-inside-avoid">
                <div class={rowHead}>
                  <h3 class="text-[14.5px] font-bold text-zinc-950 print:text-[12.5px]">
                    <a href={`${profile.links.github}/${featured.id}`} class="no-underline hover:text-sky-700">
                      {featured.data.title}
                    </a>
                  </h3>
                  {featured.data.docs && (
                    <a href={featured.data.docs} class="text-[12px] text-sky-700 no-underline print:text-[10.5px]">
                      {strip(featured.data.docs)}
                    </a>
                  )}
                </div>
                <p class="mt-0.5 text-zinc-700">{featured.data.description}</p>
                <p class="mt-1 text-[12.5px] text-zinc-600 print:text-[10.5px]">
                  <b class="font-semibold text-zinc-800">Packages:</b> {featuredPackages.map((p) => p.id).join(', ')}
                  {stats.get(featuredPackages[0]?.id ?? '') && ` (v${stats.get(featuredPackages[0].id)!.version})`}
                </p>
              </li>
            )
          }
          {
            otherPackages.map((pkg) => (
              <li class="break-inside-avoid">
                <div class={rowHead}>
                  <h3 class="text-[14.5px] font-bold text-zinc-950 print:text-[12.5px]">
                    <a href={`https://pub.dev/packages/${pkg.id}`} class="no-underline hover:text-sky-700">
                      {pkg.id}
                    </a>
                  </h3>
                  <span class="text-[12px] text-zinc-600 print:text-[10.5px]">{meta(pkg.id)}</span>
                </div>
                <p class="mt-0.5 text-zinc-700">
                  <InlineCode text={pkg.data.description} />
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Skills -->
      <section class="mb-6 break-inside-avoid">
        <h2 class={h2}>Skills</h2>
        <dl class="grid gap-x-4 gap-y-1 sm:grid-cols-[130px_1fr] print:grid-cols-[115px_1fr]">
          {
            skills.map((group) => (
              <>
                <dt class="font-semibold text-zinc-900">{group.title}</dt>
                <dd class="mb-1.5 text-zinc-700 sm:mb-0">{[...(group.primary ?? []), ...group.items].join(', ')}</dd>
              </>
            ))
          }
        </dl>
      </section>

      <!-- Education -->
      <section class="break-inside-avoid">
        <h2 class={h2}>Education</h2>
        <div class={rowHead}>
          <h3 class="text-[15px] font-bold text-zinc-950 print:text-[13px]">{education.school}</h3>
          <span class={date}>{education.period}</span>
        </div>
        <p class="font-semibold text-sky-700">{education.degree} · GPA {education.gpa}</p>
        <ul class={bullets}>
          {education.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </section>
    </main>

    <script>
      document.getElementById('print')!.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
